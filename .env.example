# Local development keeps the existing production API default when these are
# omitted. Never copy production values into a staging/preview environment.
PUBLIC_SITE_ENVIRONMENT=development

# Required together for the dedicated staging project and Vercel Preview deployments.
# The staging project's production deployment is authorized by its immutable
# VERCEL_PROJECT_ID; do not set that system variable manually.
# PUBLIC_SITE_ENVIRONMENT=staging
# PUBLIC_SITE_ORIGIN=https://the-pipe-dream-site-staging.vercel.app
# HEIST_API_ORIGIN=https://pipe-dream-band-portal-staging.vercel.app

# Production may omit the values below because the application has these exact
# defaults. If configured, only these production values are accepted:
# PUBLIC_SITE_ENVIRONMENT=production
# PUBLIC_SITE_ORIGIN=https://pipedreamband.com
# HEIST_API_ORIGIN=https://portal.pipedreamband.com
